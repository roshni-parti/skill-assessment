{
  "name": "rapido-readiness",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "import": "node scripts/import-matrix.mjs",
    "server": "node --no-warnings server/index.js",
    "client": "vite",
    "dev": "node --no-warnings server/index.js & vite & wait",
    "build": "vite build",
    "start": "npm run build && node --no-warnings server/index.js",
    "test": "node --no-warnings --test server/app.test.js",
