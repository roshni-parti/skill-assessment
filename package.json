    "build:demo": "node scripts/build-demo.mjs"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.10",
    "exceljs": "^4.4.0",
    "express": "^5.3.0",
    "google-auth-library": "^11.3.1",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.1.2",
    "vite": "^8.3.4"
  },
  "engines": {
    "node": ">=20"
  }
}
